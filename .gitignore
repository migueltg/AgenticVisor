# Build output of Rust (regenerated by cargo build).
/target/

# Local distribution packages (published versions go to GitHub Releases).
/dist/

# Program data: the search index, backups, logs and trash contain personal
# conversations and settings. They must never be uploaded.
data/
trash/
backups/
changes.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.db
search_config.json

# Python caches (from the removed Python version).
__pycache__/
*.pyc
.venv/
venv/

# Editor and system temporary files
*.dashboard-tmp
*.tmp
*.bak
*.log
.DS_Store
Thumbs.db
desktop.ini

# Credentials and secrets: never uploaded.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.*
credentials*

# Folders of AI tools and editors that may appear inside the repository.
.claude/
.cursor/
.aider*
.continue/
.idea/
.vscode/
*.code-workspace

# Generated by the Tauri build (permission schemas).
/src-tauri/gen/
